PORT=3000
DATABASE_URL=postgresql://elite:password@localhost:5432/elite_trucking
API_KEY=change-me-to-a-secure-random-string

# Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxx
CLAUDE_MODEL=claude-sonnet-4-20250514

# Twilio (SMS to drivers)
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=xxxxx
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid (emails to brokers/shippers)
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_FROM_EMAIL=ops@elitetrucking.com
SENDGRID_FROM_NAME=Elite Trucking

# Slack (approvals + notifications)
SLACK_BOT_TOKEN=xoxb-xxxxx
SLACK_SIGNING_SECRET=xxxxx
SLACK_APPROVAL_CHANNEL=C0123456789
SLACK_OPS_CHANNEL=C0123456789

# n8n
N8N_BASE_URL=http://localhost:5678

# Approval settings
APPROVAL_EXPIRY_HOURS=4

# Stub mode — set to "true" to log instead of sending real SMS/emails
STUB_MODE=true
