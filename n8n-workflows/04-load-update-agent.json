{
  "name": "Elite Trucking — Load Update Agent",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 6,8,10,12,14,16,18,20,22 * * *" }]
        }
      },
      "id": "loadupdate-schedule",
      "name": "Every 2 Hours (6AM-10PM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "load-update-ondemand",
        "responseMode": "responseNode"
      },
      "id": "loadupdate-webhook",
      "name": "On-Demand Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 500]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.AGENT_API_URL || 'http://localhost:3000'}}/api/agent/load_update/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "x-api-key", "value": "={{$env.AGENT_API_KEY}}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{ \"trigger\": \"scheduled\", \"context\": {} }",
        "options": { "timeout": 120000 }
      },
      "id": "loadupdate-api-scheduled",
      "name": "Call Load Update Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.AGENT_API_URL || 'http://localhost:3000'}}/api/agent/load_update/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "x-api-key", "value": "={{$env.AGENT_API_KEY}}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"trigger\": \"manual\", \"context\": {{ JSON.stringify($json.body || {}) }} }",
        "options": { "timeout": 120000 }
      },
      "id": "loadupdate-api-manual",
      "name": "Call Load Update (Manual)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 500]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, response: $json.response }) }}"
      },
      "id": "loadupdate-respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [750, 500]
    }
  ],
  "connections": {
    "Every 2 Hours (6AM-10PM)": { "main": [[{ "node": "Call Load Update Agent", "type": "main", "index": 0 }]] },
    "On-Demand Webhook": { "main": [[{ "node": "Call Load Update (Manual)", "type": "main", "index": 0 }]] },
    "Call Load Update (Manual)": { "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "elite-trucking" }]
}
